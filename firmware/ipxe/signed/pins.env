# The Secure Boot boot-drive binaries, exactly as the iPXE project published them. Read by the scripts; verified by scripts/fetch-ipxe-signed.sh.
# Nothing here is built by kvm-it: the shim carries Microsoft's UEFI signatures and IPXE.EFI the iPXE project's signature, so they cannot be rebuilt.
# IPXE.EFI: from the iPXE v2.0.0 release image (built by that tag's .github/workflows/build.yml, "UEFI SB" job, target bin-x86_64-efi-sb).
IPXE_TAG=v2.0.0
IPXE_COMMIT=12798ec29aa8a64d8675c4378b99f5fe28447afb
USB_URL=https://github.com/ipxe/ipxe/releases/download/v2.0.0/ipxe-x86_64-sb.usb
USB_SHA256=1bba4318a1818ef148a80b32c7cfe3199d4f7cd93b600d74f1d8f64cea64eb46
IPXE_EFI_SHA256=6558e37887516b246d6a97122e8d18bedfe4197b7ba7f67bf1bf102a16678d33
# BOOTX64.EFI: the iPXE project's fork of rhboot/shim 16.1 (upstream 16.1 plus iPXE's changes and certificate), from the ipxe/shim release `ipxe-16.1`
# (re-signed 2026-05-27 with BOTH Microsoft's 2011 and 2023 UEFI CA signatures: the copy in the v2.0.0 image carries only the 2011 one).
SHIM_URL=https://github.com/ipxe/shim/releases/download/ipxe-16.1/ipxe-shimx64.efi
SHIM_SHA256=5eecca2780bd49c900565e124516a1bd666ec5e012825f34991b6ba1ef2fa6cf
SHIM_VERSION=ipxe-16.1
SHIM_COMMIT=d0367b25d04ec90d332909b99d932571f15e5a06
SHIM_REPO=https://github.com/ipxe/shim
