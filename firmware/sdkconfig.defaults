# YD-ESP32-23 (ESP32-S3-N16R8): 16 MB quad flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM is deliberately NOT enabled for Milestone 2: nothing needs it yet and
# a wrong octal-PSRAM setting is a boot-loop risk on first flash. Revisit if
# BLE/OTA buffers ever need it.

# Native USB is owned by TinyUSB (three interfaces: boot keyboard, boot mouse, and a read-only mass-storage drive carrying iPXE).
# The console therefore stays on UART0, i.e. the board's "COM" USB-C port.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_TINYUSB_HID_COUNT=2
CONFIG_TINYUSB_CDC_ENABLED=n
# MSC is enabled for TinyUSB's class driver only; the storage callbacks are ours (usb_msc.c, read-only, served from the `ipxe`
# partition). esp_tinyusb's own storage module is never referenced, so it is not linked.
CONFIG_TINYUSB_MSC_ENABLED=y

# Partition table: the three original partitions plus the `ipxe` drive image (see partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_TINYUSB_NET_MODE_NONE=y

# Recovery: a hung task resets the chip. The USB device re-enumerates on reboot.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_INT_WDT=y
CONFIG_BOOTLOADER_WDT_ENABLE=y

# 1 ms ticks: HID readiness waits and delays are expressed in ms.
CONFIG_FREERTOS_HZ=1000

# BLE: NimBLE peripheral, LE Secure Connections, bonds persisted in NVS (docs/security.md).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
# One link: with a single slot NimBLE will not even start connectable advertising while a link exists
# (BLE_HS_ENOMEM), so a second controller can never connect. This needs
# patches/esp-idf-v5.5-nimble-conn-handle-index.patch (applied by scripts/fw.sh): stock v5.5 NimBLE indexes
# arrays of MAX_CONNECTIONS + 1 by the raw connection handle, and the ESP32-S3 controller hands out handles
# >= 2, which corrupted the host and panicked on connect.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_SM_LEGACY=n
